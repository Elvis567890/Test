  # ─────────────────────────────────────────────
  # 4. ANDROID
  # ─────────────────────────────────────────────
  build-android:
    needs: scaffold
    runs-on: ubuntu-latest
    timeout-minutes: 90
    steps:
      - uses: actions/download-artifact@v4
        with: { name: source }

      - name: Cache Gradle Wrapper
        uses: actions/cache@v4
        with:
          path: ~/.gradle/wrapper/dists
          key: ${{ runner.os }}-gradle-wrapper-v1

      - name: Cache JUCE
        id: cache-juce
        uses: actions/cache@v4
        with:
          path: JUCE
          key: ${{ runner.os }}-juce-${{ env.JUCE_VERSION }}

      - name: Clone JUCE
        if: steps.cache-juce.outputs.cache-hit != 'true'
        run: git clone --branch ${{ env.JUCE_VERSION }} --depth 1 https://github.com/juce-framework/JUCE.git

      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: '17' }

      # The ubuntu runner already ships the Android SDK + cmdline-tools, so no extra setup action is needed.
      - name: Install Android SDK components
        run: |
          export ANDROID_SDK_ROOT="$ANDROID_HOME"
          SDKMANAGER="$(command -v sdkmanager || ls "$ANDROID_HOME"/cmdline-tools/*/bin/sdkmanager | sort -V | tail -n 1)"
          echo "Using sdkmanager: $SDKMANAGER"
          yes | "$SDKMANAGER" --licenses --sdk_root="$ANDROID_HOME" > /dev/null || true
          "$SDKMANAGER" --sdk_root="$ANDROID_HOME" "ndk;$ANDROID_NDK_VERSION" "platforms;android-34" "build-tools;34.0.0"

      - name: Install Host Build Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            ninja-build \
            libcurl4-openssl-dev \
            libx11-dev libxext-dev libxrandr-dev libxinerama-dev libxcursor-dev \
            libfreetype6-dev libfontconfig1-dev libasound2-dev libjack-jackd2-dev \
            ladspa-sdk libwebkit2gtk-4.1-dev libgtk-3-dev libglu1-mesa-dev mesa-common-dev libegl-dev

      - name: Pre-build IXWebSocket for Android (all ABIs)
        run: |
          git clone --depth 1 --branch v11.4.4 https://github.com/machinezone/IXWebSocket.git ixwebsocket-src
          mkdir -p ixwebsocket-android/libs ixwebsocket-android/include

          NDK_TOOLCHAIN="$ANDROID_HOME/ndk/$ANDROID_NDK_VERSION/build/cmake/android.toolchain.cmake"
          test -f "$NDK_TOOLCHAIN" || (echo "::error::NDK toolchain not found at $NDK_TOOLCHAIN" && exit 1)

          for ABI in arm64-v8a armeabi-v7a x86_64 x86; do
            cmake -S ixwebsocket-src -B "ixwebsocket-src/build-${ABI}" \
              -DCMAKE_TOOLCHAIN_FILE="$NDK_TOOLCHAIN" \
              -DANDROID_ABI="$ABI" \
              -DANDROID_PLATFORM=android-24 \
              -DUSE_TLS=OFF \
              -DUSE_ZLIB=OFF \
              -DUSE_TEST=OFF \
              -DUSE_WS=OFF \
              -DBUILD_SHARED_LIBS=OFF \
              -DCMAKE_CXX_STANDARD=17 \
              -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
              -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
              -DCMAKE_BUILD_TYPE=Release
            cmake --build "ixwebsocket-src/build-${ABI}" --target ixwebsocket -j"$(nproc)"

            mkdir -p "ixwebsocket-android/libs/${ABI}"
            find "ixwebsocket-src/build-${ABI}" -name "libixwebsocket.a" -exec cp {} "ixwebsocket-android/libs/${ABI}/" \;
            test -f "ixwebsocket-android/libs/${ABI}/libixwebsocket.a" || (echo "::error::libixwebsocket.a missing for ${ABI}" && exit 1)
          done

          cp -r ixwebsocket-src/ixwebsocket ixwebsocket-android/include/
          echo "IXWebSocket static libraries built:"
          find ixwebsocket-android -name "*.a"

      - name: Build Projucer CLI
        run: |
          cd JUCE/extras/Projucer/Builds/LinuxMakefile
          make -j"$(nproc)" CONFIG=Release
          echo "$GITHUB_WORKSPACE/JUCE/extras/Projucer/Builds/LinuxMakefile/build" >> $GITHUB_PATH

      - name: Generate Android Gradle Project via Projucer
        run: |
          export ANDROID_SDK_ROOT="$ANDROID_HOME"

          # 1. Substitute the include path in the .jucer file
          sed -i "s|IXWEBSOCKET_INCLUDE_PATH|$GITHUB_WORKSPACE/ixwebsocket-android/include|g" AILiveBand.jucer

          # 2. Set Projucer paths and resave
          Projucer --set-global-search-path linux defaultJuceModulePath "$GITHUB_WORKSPACE/JUCE/modules"
          Projucer --set-global-search-path linux androidSDKPath "$ANDROID_HOME"
          Projucer --resave AILiveBand.jucer

          echo "Verifying generated Android project..."
          ls -la Builds/Android/ || (echo "::error::Builds/Android not found" && exit 1)

          # ── PATCH 1: link IXWebSocket (static) + add its headers, inserted AFTER project() ──
          CMAKE_FILE="Builds/Android/app/CMakeLists.txt"
          if [ -f "$CMAKE_FILE" ]; then
            echo "Patching $CMAKE_FILE ..."
            python3 - "$CMAKE_FILE" "$GITHUB_WORKSPACE" <<'PY'
          import re, sys
          path, ws = sys.argv[1], sys.argv[2]
          lines = open(path).read().split("\n")
          lines = [l for l in lines if not re.search(r"target_link_libraries.*AILiveBand", l)]
          abi_var = "$" + "{ANDROID_ABI}"
          inject = [
              'include_directories("%s/ixwebsocket-android/include")' % ws,
              'link_libraries("%s/ixwebsocket-android/libs/%s/libixwebsocket.a")' % (ws, abi_var),
          ]
          idx = None
          for i, l in enumerate(lines):
              if re.match(r"^\s*project\s*\(", l, re.I):
                  idx = i
                  break
          if idx is None:
              for i, l in enumerate(lines):
                  if re.match(r"^\s*cmake_minimum_required\s*\(", l, re.I):
                      idx = i
                      break
          if idx is None:
              lines = inject + lines
          else:
              lines = lines[:idx + 1] + inject + lines[idx + 1:]
          open(path, "w").write("\n".join(lines))
          PY
            grep -n "ixwebsocket" "$CMAKE_FILE" || (echo "::error::CMake patch did not apply" && exit 1)
          else
            echo "::error::$CMAKE_FILE not found" && exit 1
          fi

          # ── PATCH 2: manifest permissions (mic + internet) and cleartext ws:// ──
          MANIFEST_PATH="Builds/Android/app/src/main/AndroidManifest.xml"
          for PERM in RECORD_AUDIO INTERNET; do
            if ! grep -q "android.permission.$PERM" "$MANIFEST_PATH"; then
              echo "$PERM missing from manifest, injecting..."
              sed -i "/<application/i \    <uses-permission android:name=\"android.permission.$PERM\" />" "$MANIFEST_PATH"
            fi
            grep -q "android.permission.$PERM" "$MANIFEST_PATH" \
              && echo "✅ $PERM permission verified in manifest." \
              || (echo "::error::$PERM permission missing from manifest" && exit 1)
          done
          if ! grep -q "usesCleartextTraffic" "$MANIFEST_PATH"; then
            sed -i 's|<application|<application android:usesCleartextTraffic="true"|' "$MANIFEST_PATH"
          fi

          # ── PATCH 3: Gradle fixes ──
          GRADLE_FILE="Builds/Android/app/build.gradle"
          if [ -f "$GRADLE_FILE" ]; then
            sed -i '/DANDROID_STL=c++_shared/d' "$GRADLE_FILE"
            sed -i '/CMAKE_MAKE_PROGRAM/d' "$GRADLE_FILE"
            if ! grep -q ndkVersion "$GRADLE_FILE"; then
              sed -i "0,/^android {/s//android {\n    ndkVersion \"$ANDROID_NDK_VERSION\"/" "$GRADLE_FILE"
            fi
          fi

      # (moved here: the wrapper properties only exist AFTER Projucer generated the project)
      - name: Prefetch Gradle Distribution with Retries
        run: |
          PROPS_FILE="Builds/Android/gradle/wrapper/gradle-wrapper.properties"
          if [ -f "$PROPS_FILE" ]; then
            URL=$(sed -n 's/^distributionUrl=//p' "$PROPS_FILE" | sed 's/\\//g')
            ZIP_NAME=${URL##*/}
            DIST_NAME=${ZIP_NAME%.zip}
            python3 - "$URL" > gradle_hash.txt <<'PY'
          import hashlib, sys
          n = int.from_bytes(hashlib.md5(sys.argv[1].encode()).digest(), "big")
          d = "0123456789abcdefghijklmnopqrstuvwxyz"
          s = ""
          while n:
              n, r = divmod(n, 36)
              s = d[r] + s
          print(s)
          PY
            HASH=$(cat gradle_hash.txt)
            DIST_DIR="$HOME/.gradle/wrapper/dists/$DIST_NAME/$HASH"
            mkdir -p "$DIST_DIR"

            if [ ! -f "$DIST_DIR/$ZIP_NAME" ] && [ ! -d "$DIST_DIR/${DIST_NAME%-bin}" ]; then
              for i in 1 2 3 4 5 6 7 8; do
                if curl -fsSL --connect-timeout 15 --max-time 300 -o "$DIST_DIR/$ZIP_NAME.part" "$URL" && \
                   unzip -tq "$DIST_DIR/$ZIP_NAME.part" > /dev/null 2>&1; then
                  mv "$DIST_DIR/$ZIP_NAME.part" "$DIST_DIR/$ZIP_NAME"
                  echo "✅ Gradle distribution downloaded (attempt $i)"
                  break
                fi
                echo "⚠️ Download failed (attempt $i/8), retrying in 15s..."
                rm -f "$DIST_DIR/$ZIP_NAME.part"
                sleep 15
              done
            else
              echo "✅ Gradle distribution already present."
            fi
          fi

      - name: Build APK with Gradle
        run: |
          cd Builds/Android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon --stacktrace

      - name: Verify IXWebSocket is linked into the APK
        run: |
          APK_PATH=$(find Builds/Android -name "*.apk" -type f | head -n 1)
          test -n "$APK_PATH" || (echo "::error::No APK found" && exit 1)
          mkdir -p apk_check
          unzip -o "$APK_PATH" "lib/arm64-v8a/*.so" -d apk_check
          # Symbols may be hidden/stripped, so look for a string literal that only IXWebSocket contains.
          if grep -aq "Sec-WebSocket-Key" apk_check/lib/arm64-v8a/*.so; then
            echo "✅ IXWebSocket code found. Library is linked."
          else
            echo "::error::IXWebSocket NOT found in the native library."
            exit 1
          fi

      - name: Locate and Copy APK
        run: |
          APK_PATH=$(find Builds/Android -name "*.apk" -type f | head -n 1)
          if [ -n "$APK_PATH" ]; then
            cp "$APK_PATH" ./AILiveBand.apk
          else
            echo "::error::No APK file was generated."
            exit 1
          fi

      - name: Upload Android APK
        uses: actions/upload-artifact@v4
        with:
          name: AILiveBand-android
          path: ./AILiveBand.apk
          if-no-files-found: error
