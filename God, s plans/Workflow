      - name: Package Linux app
        run: |
          ls -la build/AILiveBand_artefacts/Release/
          tar -czf AILiveBand-linux.tar.gz -C build/AILiveBand_artefacts/Release "AI Live Band"

      - name: Upload Linux app
        uses: actions/upload-artifact@v4
