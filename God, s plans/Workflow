          cat > Source/MainComponent.cpp << 'EOF'
          #include "MainComponent.h"
          MainComponent::MainComponent() {
              addAndMakeVisible(noteLabel); addAndMakeVisible(chordLabel); addAndMakeVisible(stateLabel);
              addAndMakeVisible(startButton); addAndMakeVisible(testButton); addAndMakeVisible(settingsButton);
              stateLabel.setFont(juce::Font(juce::FontOptions(28.0f, juce::Font::bold)));
              noteLabel.setFont(juce::Font(juce::FontOptions(48.0f, juce::Font::bold)));
              chordLabel.setFont(juce::Font(juce::FontOptions(36.0f)));
              noteLabel.setJustificationType(juce::Justification::centred);
              chordLabel.setJustificationType(juce::Justification::centred);
              stateLabel.setJustificationType(juce::Justification::centred);
              noteLabel.setColour(juce::Label::textColourId, juce::Colours::white);
              chordLabel.setColour(juce::Label::textColourId, juce::Colour::fromRGB(0, 255, 200));
              stateLabel.setColour(juce::Label::textColourId, juce::Colours::cyan);
              startButton.setColour(juce::TextButton::buttonColourId, juce::Colour::fromRGB(0, 100, 80));
              testButton.setColour(juce::TextButton::buttonColourId, juce::Colour::fromRGB(100, 80, 0));
              settingsButton.setColour(juce::TextButton::buttonColourId, juce::Colour::fromRGB(40, 40, 40));
              startButton.onClick = [this] {
                  if (!deviceManager.getCurrentAudioDevice()) {
                      if (!juce::RuntimePermissions::isGranted(juce::RuntimePermissions::recordAudio)) {
                          juce::RuntimePermissions::request(juce::RuntimePermissions::recordAudio, [this](bool granted) {
                              if (granted) startAudio(); else stateLabel.setText("MIC DENIED", juce::dontSendNotification);
                          });
                      } else startAudio();
                  } else { stopAudio(); stateLabel.setText("OFFLINE", juce::dontSendNotification); startButton.setButtonText("Start"); }
              };
              testButton.onClick = [this] {
                  if (!arranger || !arranger->isConnected()) return;
                  juce::Timer::callAfterDelay(0, [this] { if (arranger) arranger->sendToServer(60, 0.8f, 0.1f, "Cmaj"); });
                  juce::Timer::callAfterDelay(200, [this] { if (arranger) arranger->sendToServer(64, 0.8f, 0.1f, "Cmaj"); });
                  juce::Timer::callAfterDelay(400, [this] { if (arranger) arranger->sendToServer(67, 0.8f, 0.1f, "Cmaj"); });
                  juce::Timer::callAfterDelay(600, [this] { if (arranger) arranger->sendToServer(60, 0.8f, 0.1f, "Cmaj"); });
              };
              settingsButton.onClick = [this] { showAudioSettings(); };
              setSize(700, 600);
              startTimerHz(60);
          }
          MainComponent::~MainComponent() { stopTimer(); stopAudio(); }
          void MainComponent::showAudioSettings() {
              // A fresh selector each time, so the dialog can be opened again after it is closed.
              auto* selector = new juce::AudioDeviceSelectorComponent(deviceManager, 1, 2, 2, 2, false, false, true, false);
              selector->setSize(500, 400);
              juce::DialogWindow::LaunchOptions options;
              options.content.setOwned(selector);
              options.dialogTitle = "Audio Routing (Mic & Speaker)";
              options.dialogBackgroundColour = juce::Colours::darkgrey;
              options.escapeKeyTriggersCloseButton = true;
              options.useNativeTitleBar = true;
              options.resizable = false;
              options.launchAsync();
          }
          void MainComponent::startAudio() {
              if (deviceManager.getCurrentAudioDevice()) return;
              arranger = std::make_unique<Arranger>(chordInference, synth);
              auto err = deviceManager.initialiseWithDefaultDevices(1, 2);
              if (err.isNotEmpty()) { stateLabel.setText("AUDIO ERROR", juce::dontSendNotification); arranger.reset(); return; }
              deviceManager.addAudioCallback(this);
              stateLabel.setText("CONNECTING...", juce::dontSendNotification);
              startButton.setButtonText("Stop");
              if (arranger) arranger->start();
          }
          void MainComponent::stopAudio() {
              // Stop audio first so the callback can no longer touch the arranger.
              if (deviceManager.getCurrentAudioDevice()) { deviceManager.removeAudioCallback(this); deviceManager.closeAudioDevice(); }
              if (arranger) { arranger->stop(); arranger.reset(); }
          }
          void MainComponent::paint(juce::Graphics& g) {
              g.fillAll(juce::Colour::fromRGB(10, 12, 18));
              auto center = getLocalBounds().getCentre();
              float radius = 100.0f + (currentEnergy.load() * 200.0f);
              juce::ColourGradient grad(juce::Colour::fromRGB(0, 255, 200).withAlpha(0.2f), (float)center.x, (float)center.y,
                                        juce::Colour::fromRGB(0, 0, 0).withAlpha(0.0f), (float)center.x + radius, (float)center.y, true);
              g.setGradientFill(grad);
              g.fillEllipse((float)center.x - radius, (float)center.y - radius, radius * 2, radius * 2);
          }
          void MainComponent::resized() {
              auto area = getLocalBounds().reduced(40);
              stateLabel.setBounds(area.removeFromTop(60));
              area.removeFromTop(40);
              noteLabel.setBounds(area.removeFromTop(100));
              chordLabel.setBounds(area.removeFromTop(60));
              area.removeFromBottom(80);
              auto buttonArea = area.removeFromBottom(60);
              startButton.setBounds(buttonArea.removeFromLeft(buttonArea.getWidth() / 3).reduced(10));
              testButton.setBounds(buttonArea.removeFromLeft(buttonArea.getWidth() / 2).reduced(10));
              settingsButton.setBounds(buttonArea.reduced(10));
          }
          void MainComponent::audioDeviceAboutToStart(juce::AudioIODevice* device) {
              pitchDetector = std::make_unique<PitchDetector>(device->getCurrentSampleRate());
              synth.initialize(device->getCurrentSampleRate());
          }
          void MainComponent::audioDeviceStopped() { pitchDetector.reset(); }
          void MainComponent::audioDeviceIOCallbackWithContext(const float* const* inputChannelData, int numInputChannels, float* const* outputChannelData, int numOutputChannels, int numSamples, const juce::AudioIODeviceCallbackContext&) {
              if (numInputChannels > 0 && inputChannelData[0] && pitchDetector) {
                  float rms = 0.0f;
                  for (int i = 0; i < numSamples; ++i) rms += inputChannelData[0][i] * inputChannelData[0][i];
                  rms = std::sqrt(rms / (float)numSamples);
                  float confidence = 0.0f;
                  float freq = pitchDetector->detect(inputChannelData[0], numSamples, confidence);
                  currentConfidence.store(confidence);
                  currentEnergy.store(rms);
                  if (freq > 0.0f && confidence > 0.4f) {
                      currentFreq.store(freq);
                      pitchSpeed.store(std::abs(freq - lastPitch) / 100.0f);
                      lastPitch = freq;
                      chordInference.addNote(PitchDetector::freqToMidi(freq));
                  } else {
                      currentFreq.store(0.0f);
                  }
                  if (arranger) arranger->sendToServer(PitchDetector::freqToMidi(freq), rms, pitchSpeed.load(), chordInference.getChord());
              }
              // Always fill every output channel (never leave garbage in the buffer).
              if (numOutputChannels >= 1 && outputChannelData[0])
                  synth.render(outputChannelData[0], (numOutputChannels >= 2 ? outputChannelData[1] : nullptr), numSamples);
              for (int ch = 2; ch < numOutputChannels; ++ch)
                  if (outputChannelData[ch]) juce::FloatVectorOperations::clear(outputChannelData[ch], numSamples);
          }
          void MainComponent::timerCallback() {
              float f = currentFreq.load(); float conf = currentConfidence.load(); float energy = currentEnergy.load();
              if (f > 0.0f && conf > 0.4f) {
                  noteLabel.setText(PitchDetector::freqToNote(f), juce::dontSendNotification);
                  chordLabel.setText(chordInference.getChord(), juce::dontSendNotification);
                  stateLabel.setText("SINGING", juce::dontSendNotification);
                  stateLabel.setColour(juce::Label::textColourId, juce::Colours::cyan);
              } else if (energy > 0.02f) {
                  noteLabel.setText("-", juce::dontSendNotification);
                  chordLabel.setText("-", juce::dontSendNotification);
                  stateLabel.setText("TALKING (MUTED)", juce::dontSendNotification);
                  stateLabel.setColour(juce::Label::textColourId, juce::Colours::yellow);
              } else {
                  noteLabel.setText("-", juce::dontSendNotification);
                  chordLabel.setText("-", juce::dontSendNotification);
                  if (arranger && arranger->isConnected()) { stateLabel.setText("LISTENING...", juce::dontSendNotification); stateLabel.setColour(juce::Label::textColourId, juce::Colours::green); }
                  else { stateLabel.setText("WAITING FOR SERVER", juce::dontSendNotification); stateLabel.setColour(juce::Label::textColourId, juce::Colours::red); }
              }
              repaint();
          }
          EOF

          cat > Source/Main.cpp << 'EOF'
