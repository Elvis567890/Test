name: Build AI Live Band App 
on:
  push:
    branches: [ main, master, first-prototype ]
  pull_request:
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  JUCE_VERSION: 8.0.6
  ANDROID_NDK_VERSION: 26.3.11579264

jobs:
  scaffold:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Download SoundFont and TinySoundFont
        run: |
          curl -fsSL --retry 5 --retry-delay 3 -o tsf.h https://raw.githubusercontent.com/schellingb/TinySoundFont/master/tsf.h
          curl -fsSL --retry 5 --retry-delay 3 -o SoundFont.sf2 https://github.com/urish/cinto/raw/master/media/TimGM6mb.sf2
          test -s tsf.h
          head -c 4 SoundFont.sf2 | grep -q RIFF || (echo "::error::SoundFont download is not a valid .sf2" && exit 1)

      - name: Create project files
        run: |
          mkdir -p Source
          mv tsf.h Source/tsf.h
          mv SoundFont.sf2 Source/SoundFont.sf2

          # ── Config.h ──
          cat > Source/Config.h << 'EOF'
          #pragma once
          #define AI_LIVE_BAND_SERVER_URL "ws://13.140.90.83:8765"
          EOF

          # ── CMakeLists.txt (DESKTOP ONLY: Linux, Windows, macOS) ──
          cat > CMakeLists.txt << 'EOF'
          cmake_minimum_required(VERSION 3.22)
          project(AILiveBand VERSION 0.1.0 LANGUAGES C CXX)
          set(CMAKE_CXX_STANDARD 17)
          set(CMAKE_CXX_STANDARD_REQUIRED ON)

          # IXWebSocket still declares an old cmake_minimum_required; CMake 4+ rejects that unless overridden.
          set(CMAKE_POLICY_VERSION_MINIMUM 3.5)

          add_subdirectory(JUCE)

          include(FetchContent)
          FetchContent_Declare(
            ixwebsocket
            GIT_REPOSITORY https://github.com/machinezone/IXWebSocket.git
            GIT_TAG        v11.4.4
          )
          set(USE_TLS  OFF CACHE BOOL "" FORCE)
          set(USE_ZLIB OFF CACHE BOOL "" FORCE)
          set(USE_TEST OFF CACHE BOOL "" FORCE)
          set(USE_WS   OFF CACHE BOOL "" FORCE)
          set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
          FetchContent_MakeAvailable(ixwebsocket)

          juce_add_binary_data(BinaryData SOURCES Source/SoundFont.sf2)

          juce_add_gui_app(AILiveBand
            PRODUCT_NAME "AI Live Band"
            COMPANY_NAME "AILiveBand"
            VERSION "0.1.0"
            MICROPHONE_PERMISSION_ENABLED TRUE
            MICROPHONE_PERMISSION_TEXT "AI Live Band needs microphone access."
          )

          juce_generate_juce_header(AILiveBand)

          target_sources(AILiveBand PRIVATE
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/Main.cpp
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/MainComponent.cpp
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/PitchDetector.cpp
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/ChordInference.cpp
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/Arranger.cpp
            ${CMAKE_CURRENT_SOURCE_DIR}/Source/SoundFontSynth.cpp
          )

          target_compile_definitions(AILiveBand PRIVATE
            JUCE_WEB_BROWSER=0
            JUCE_USE_CURL=0
            JUCE_APPLICATION_NAME_STRING="$<TARGET_PROPERTY:AILiveBand,JUCE_PRODUCT_NAME>"
            JUCE_APPLICATION_VERSION_STRING="$<TARGET_PROPERTY:AILiveBand,JUCE_VERSION>"
          )

          if(WIN32)
            target_compile_definitions(AILiveBand PRIVATE NOMINMAX)
          endif()

          if(NOT MSVC)
            target_compile_options(AILiveBand PRIVATE -Wno-zero-as-null-pointer-constant -Wno-unused-function)
          endif()

          target_link_libraries(AILiveBand
            PRIVATE
              BinaryData
              juce::juce_audio_utils
              juce::juce_audio_devices
              juce::juce_dsp
              juce::juce_gui_extra
              juce::juce_events
              ixwebsocket
            PUBLIC
              juce::juce_recommended_config_flags
              juce::juce_recommended_warning_flags
          )
          EOF

